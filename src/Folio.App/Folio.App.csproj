<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ClearNote</AssemblyName>
    <RootNamespace>Folio.App</RootNamespace>
    <Title>ClearNote</Title>
    <Product>ClearNote</Product>
    <Description>ClearNote</Description>
    <Version>1.9.5</Version>
    <AssemblyVersion>1.9.5.0</AssemblyVersion>
    <FileVersion>1.9.5.0</FileVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Folio.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Folio.Core\Folio.Core.csproj" />
    <EmbeddedResource Include="Assets\welcome-landscape.png" LogicalName="Folio.App.Assets.WelcomeLandscape" />
  </ItemGroup>
</Project>



